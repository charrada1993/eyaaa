# Firebase Configuration
# Create a new Firebase project at https://console.firebase.google.com/
# Then go to Project Settings -> Service Accounts -> Generate New Private Key
# Copy the JSON content into the respective fields below

# Or, alternatively, set FIREBASE_ADMIN_SDK_PATH to the path of your downloaded JSON file
FIREBASE_ADMIN_SDK_PATH=./firebase-service-account.json

# Firebase Realtime Database URL (found in Realtime Database section)
# Example: https://your-project-id-default-rtdb.firebaseio.com/
FIREBASE_DATABASE_URL=

# Firebase Storage bucket URL (found in Storage section, without gs:// prefix)
# Example: your-project-id.appspot.com
FIREBASE_STORAGE_BUCKET=

# Admin password for accessing the QR code generation page and gallery management
ADMIN_PASSWORD=eya_houcem_2024
